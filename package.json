{
  "name": "kinetix",
  "private": true,
  "version": "1.0.0",
  "description": "KINETIX - Science-Based Hypertrophy & Strength Training Engine",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node scripts/sw-precache.mjs && node scripts/verify-manifest.mjs",
    "build:capacitor": "vite build && node scripts/sw-precache.mjs && node scripts/verify-manifest.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "test:direct": "node node_modules/vitest/vitest.mjs run --silent",
    "lint": "eslint . && tsc --noEmit",
    "lint:eslint": "eslint .",
    "typecheck": "tsc --noEmit",
    "vercel-build": "vite build && node scripts/sw-precache.mjs && node scripts/verify-manifest.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capgo/capacitor-health": "^8.10.5",
    "@tailwindcss/vite": "^4.1.14",
    "canvas-confetti": "^1.9.4",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.1",
    "@eslint/js": "^10.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.4",
    "esbuild": "^0.25.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
