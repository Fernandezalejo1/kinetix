# https://editorconfig.org
# Normaliza lo que hoy está mezclado en el repo (CRLF en casi todo src/):
# al guardar un archivo, los editores que soportan EditorConfig lo pasan a LF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,jsonc}]
indent_size = 2

[*.{bat,cmd,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab

# Minificados / generados: no reformatear.
[dist/**]
insert_final_newline = false
[public/sw.js]
trim_trailing_whitespace = true
